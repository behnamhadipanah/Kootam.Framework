{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=.;Database=KootamTranslatorSample;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Translator": {
    "ConnectionString": "Server=.;Database=KootamTranslatorSample;Trusted_Connection=True;TrustServerCertificate=True",
    "AutoCreateSqlTable": true,
    "UseCaching": true,
    "ReloadDataIntervalInMinuts": 5,
    "DefaultCulture": "fa-IR",
    "FallbackCulture": "en-US",
    "DefaultTranslations": [
      {
        "Key": "WelcomeMessage",
        "Value": "Welcome",
        "Culture": "en-US"
      },
      {
        "Key": "WelcomeMessage",
        "Value": "خوش آمدید",
        "Culture": "fa-IR"
      }
    ]
  }
}
